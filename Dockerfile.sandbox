ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 g++ openjdk-17-jdk-headless nodejs esbuild golang-go ruby && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*
COPY server/sandbox.py /sandbox.py
ARG RYCRUIT_SANDBOX_HASH
LABEL dev.rycruit.sandbox-hash=$RYCRUIT_SANDBOX_HASH
ENTRYPOINT ["python3", "/sandbox.py"]
